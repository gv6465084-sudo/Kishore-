# GEMINI_API_KEY: Free-tier Gemini API key (automatically injected by Google AI Studio Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected runtime URL for the application.
APP_URL="MY_APP_URL"

# GOOGLE_FACT_CHECK_API_KEY: Optional free-tier Google Fact Check Tools API key.
# Leave empty to run NewsCheck using local claim/manipulation analysis, user-supplied evidence URLs, and Gemini.
GOOGLE_FACT_CHECK_API_KEY=""
